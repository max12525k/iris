# ──────────────── Container UID/GID ────────────────
# So Iris-created files in volumes are owned by host user.
# (Variable names stay HERMES_* because the upstream container reads them.)
# Get your values with: id -u  /  id -g
HERMES_UID=501
HERMES_GID=20

# ──────────────── Database passwords ────────────────
# Generate strong values: openssl rand -hex 32
LITELLM_DB_PASSWORD=replace-me-with-openssl-rand-hex-32
HONCHO_DB_PASSWORD=replace-me-with-openssl-rand-hex-32

# ──────────────── Messaging adapters (optional) ────────────────
# Hermes auto-starts each bot when BOT_TOKEN is set. ALLOWED_USERS gates who
# can talk to it (DM access). Leave blank if you don't want that adapter.
#
# Telegram setup:
#   1. Open @BotFather on Telegram, send /newbot, follow prompts → get token
#   2. Open @userinfobot, send any message → get your numeric user ID
#   3. Uncomment + paste below
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_ALLOWED_USERS=123456789                        # comma-separated for multiple
# TELEGRAM_HOME_CHANNEL=123456789                         # where scheduled tasks deliver; usually your user ID for DMs
#
# Discord setup:
#   1. https://discord.com/developers/applications → New Application → Bot
#      → enable "Server Members Intent" + "Message Content Intent"
#   2. Reset Token → copy
#   3. OAuth2 → URL Generator → bot + applications.commands scopes;
#      permissions: View Channels, Send Messages, Read Message History,
#      Attach Files, Embed Links, Send Messages in Threads, Add Reactions
#   4. Open the generated URL, add bot to your server
#   5. In Discord: Settings → Advanced → Developer Mode ON, right-click
#      your username → Copy User ID
# DISCORD_BOT_TOKEN=MTI...
# DISCORD_ALLOWED_USERS=123456789012345678                # comma-separated for multiple
# DISCORD_HOME_CHANNEL=                                    # optional channel ID for proactive messages
