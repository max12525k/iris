# ─────────── Secrets — NEVER commit ───────────
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credentials, keys, tokens
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
secrets/
credentials/
service-account*.json
auth.json

# ─────────── Upstream clones — managed separately ───────────
hermes-agent/
honcho-src/

