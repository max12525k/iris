#!/usr/bin/env bash
# iris-cron — atomically schedule a cron job AND record it in cron.yaml so
# the schedule survives container recreate, image rebuild, and fresh clones.
#
# Usage:
#   iris-cron add <schedule> <prompt> --name <name> [--deliver target] [--skill name]...
#   iris-cron rm <name>
#   iris-cron list
#
# Examples:
#   iris-cron add "0 9 * * 1" "Summarize last week's GitHub activity" --name weekly-github --deliver telegram
#   iris-cron add "every 6h"  "Check disk usage; alert if >80%"        --name disk-watch
#   iris-cron rm weekly-github
#
# The wrapper performs three actions atomically:
#   1. Updates iris/iris-config/cron.yaml (append for add, remove for rm)
#   2. Calls iris-cron-reconcile.py to bring Hermes's cron state in line
#   3. Auto-commits on iris-self/cron-<name> branch (stash dance keeps the
#      user's working tree untouched)

set -euo pipefail

REPO="${IRIS_REPO_ROOT:-/repo}"
MANIFEST="$REPO/iris/iris-config/cron.yaml"
RECONCILE=/usr/local/bin/iris-cron-reconcile

if [ ! -f "$MANIFEST" ]; then
    echo "iris-cron: manifest missing at $MANIFEST" >&2
    exit 1
fi

usage() {
    cat >&2 <<'EOF'
usage:
  iris-cron add <schedule> <prompt> --name <name> [--deliver target] [--skill name]... [--workdir path]
  iris-cron rm <name>
  iris-cron list
EOF
    exit 64
}

ACTION="${1:-}"
shift || true

case "$ACTION" in
    list)
        exec /opt/hermes/.venv/bin/hermes cron list
        ;;
    add|rm) ;;
    "" | -h | --help) usage ;;
    *) echo "iris-cron: unknown action '$ACTION'" >&2; usage ;;
esac

# ─── Parse args for add / rm ────────────────────────────────────────────────

NAME=""
SCHEDULE=""
PROMPT=""
DELIVER=""
WORKDIR=""
SKILLS=()

if [ "$ACTION" = "rm" ]; then
    NAME="${1:-}"
    [ -z "$NAME" ] && { echo "iris-cron rm: name required" >&2; usage; }
elif [ "$ACTION" = "add" ]; then
    # First two positional args: schedule + prompt; rest are flags
    SCHEDULE="${1:-}"; shift || true
    PROMPT="${1:-}"; shift || true
    [ -z "$SCHEDULE" ] || [ -z "$PROMPT" ] && { echo "iris-cron add: schedule and prompt required" >&2; usage; }

    while [ $# -gt 0 ]; do
        case "$1" in
            --name)    NAME="${2:-}"; shift 2;;
            --deliver) DELIVER="${2:-}"; shift 2;;
            --workdir) WORKDIR="${2:-}"; shift 2;;
            --skill)   SKILLS+=("${2:-}"); shift 2;;
            *)         echo "iris-cron add: unknown flag '$1'" >&2; usage;;
        esac
    done
    [ -z "$NAME" ] && { echo "iris-cron add: --name required" >&2; usage; }
fi

# ─── Edit the manifest via Python (handles YAML escaping correctly) ─────────

REASON=""  # captured for commit message via env
update_manifest() {
    local action="$1"
    NAME="$NAME" SCHEDULE="$SCHEDULE" PROMPT="$PROMPT" \
    DELIVER="$DELIVER" WORKDIR="$WORKDIR" \
    SKILLS_JSON="$(printf '%s\n' "${SKILLS[@]:-}" | /opt/hermes/.venv/bin/python -c 'import json,sys; print(json.dumps([s for s in sys.stdin.read().splitlines() if s]))')" \
    ACTION="$action" MANIFEST_PATH="$MANIFEST" \
    /opt/hermes/.venv/bin/python - <<'PY'
import json, os, sys
import yaml

path = os.environ["MANIFEST_PATH"]
action = os.environ["ACTION"]
name = os.environ["NAME"]

with open(path) as f:
    text = f.read()
data = yaml.safe_load(text) or {}
jobs = data.get("jobs") or []
# Drop any existing entry with this name (rm semantics, or replace-on-add)
jobs = [j for j in jobs if (j or {}).get("name") != name]

if action == "add":
    entry = {
        "name": name,
        "schedule": os.environ["SCHEDULE"],
        "prompt": os.environ["PROMPT"],
    }
    if os.environ.get("DELIVER"):
        entry["deliver"] = os.environ["DELIVER"]
    skills = json.loads(os.environ.get("SKILLS_JSON") or "[]")
    if skills:
        entry["skills"] = skills
    if os.environ.get("WORKDIR"):
        entry["workdir"] = os.environ["WORKDIR"]
    jobs.append(entry)

data["jobs"] = jobs
with open(path, "w") as f:
    # Preserve the leading comment block from the original file
    head_lines = []
    for line in text.splitlines():
        if line.startswith("#") or not line.strip():
            head_lines.append(line)
        else:
            break
    f.write("\n".join(head_lines).rstrip() + "\n\n")
    yaml.safe_dump(data, f, sort_keys=False, default_flow_style=False, width=120)
PY
}

case "$ACTION" in
    add) echo "→ adding cron job 'iris.$NAME'  ($SCHEDULE)";;
    rm)  echo "→ removing cron job 'iris.$NAME'";;
esac

_otel_emit --category cron --action "$ACTION" --subject "$NAME" --outcome started \
           --attr schedule="$SCHEDULE" --attr deliver="$DELIVER" 2>/dev/null || true
_event_log --category cron --action started --subject "$NAME" \
           --payload-key schedule="$SCHEDULE" --payload-key deliver="$DELIVER" \
           --payload-key wrapper_action="$ACTION" 2>/dev/null || true

# ─── V2.1 — direct manifest update + reconcile, no git plumbing ────────────
# The wrapper updates iris-config/cron.yaml in-place on whatever branch is
# checked out (working tree gets dirty). iris-curator picks up the dirty
# manifest on its nightly run and bundles into a single PR.

cd "$REPO"

update_manifest "$ACTION"

if ! "$RECONCILE" "$MANIFEST"; then
    echo "iris-cron: reconcile failed (see stderr above)" >&2
    _otel_emit --category cron --action "$ACTION" --subject "$NAME" \
               --outcome error --attr error_class=reconcile_failed 2>/dev/null || true
    _event_log --category cron --action "$ACTION" --subject "$NAME" --outcome error \
               --payload-key error_class=reconcile_failed 2>/dev/null || true
    exit 1
fi

_otel_emit --category cron --action "$ACTION" --subject "$NAME" --outcome ok \
           --attr schedule="$SCHEDULE" 2>/dev/null || true
_event_log --category cron --action "$ACTION" --subject "$NAME" --outcome ok \
           --payload-key schedule="$SCHEDULE" --payload-key deliver="$DELIVER" 2>/dev/null || true

echo ""
echo "✓ cron job '$NAME' ${ACTION}ed"
echo "  manifest: iris/iris-config/cron.yaml (working tree dirty; curator will batch)"
echo "  next:    iris-curator --since 24h  (preview)  or  iris-curator --emit-pr  (commit + PR)"
