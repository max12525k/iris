#!/usr/bin/env bash
# iris-learn (V2.1) — install a package, update the manifest, emit events.
#
# What changed from V2.0:
#   V2.0 created a per-action iris-self/learn-<pkg> git branch + commit on
#   every invocation. That was the github-flow bottleneck — 6+ wrapper bugs
#   came from the stash dance, branch sprawl needed periodic make iris-clean,
#   and review noise grew with every action.
#
#   V2.1 strips all the git plumbing. Wrappers update the manifest in-place
#   on whatever branch is checked out. The iris-curator nightly run reads
#   the event log + dirty manifest paths and produces ONE PR per cadence.
#   Result: ms-latency wrappers, 1 review/day instead of N branches/day.
#
# Three steps:
#   1. Install the package (apt-get / uv pip / npm). On failure: record
#      lesson, emit error event, exit non-zero.
#   2. Update /repo/iris/iris-learned/<eco>.txt + rationale.md in-place.
#      Idempotent — won't add duplicates. Working tree gets dirty; the
#      curator handles staging + PR.
#   3. Emit success events (event log + OTel).
#
# Usage: iris-learn <ecosystem> <package> [reason]
#   ecosystem: apt | python | npm

set -euo pipefail

ECO="${1:-}"
PKG="${2:-}"
REASON="${3:-no reason given}"

if [ -z "$ECO" ] || [ -z "$PKG" ]; then
    cat >&2 <<EOF
usage: iris-learn <apt|python|npm> <package> [reason]

  apt     Debian/Ubuntu system package (uses narrow-scoped sudo)
  python  pip-installable package (lands in /opt/hermes/.venv)
  npm     global npm package (lands in ~/.local/lib/node_modules)

Reason should be one short sentence — it goes into the learning journal
and helps the curator's PR explain why this package landed in the manifest.
EOF
    exit 64
fi

case "$ECO" in
    apt|python|npm) ;;
    *) echo "iris-learn: unknown ecosystem '$ECO' (use apt|python|npm)" >&2; exit 64 ;;
esac

REPO="${IRIS_REPO_ROOT:-/repo}"
LEARN_DIR="$REPO/iris/iris-learned"
[ -d "$LEARN_DIR" ] || { echo "iris-learn: manifest dir missing at $LEARN_DIR" >&2; exit 1; }

# ─── Step 1: install ────────────────────────────────────────────────────────

echo "→ installing $ECO $PKG"
_otel_emit --category package --action install --subject "$ECO:$PKG" \
           --outcome started --attr eco="$ECO" --attr reason="$REASON" 2>/dev/null || true
_event_log --category package --action started --subject "$ECO:$PKG" \
           --payload-key eco="$ECO" --payload-key reason="$REASON" 2>/dev/null || true

INSTALL_RC=0
case "$ECO" in
    apt)
        sudo apt-get update -qq
        sudo apt-get install -y --no-install-recommends "$PKG" || INSTALL_RC=$?
        ;;
    python)
        uv pip install --quiet --python /opt/hermes/.venv/bin/python "$PKG" || INSTALL_RC=$?
        ;;
    npm)
        npm config set prefix "$HOME/.local" --location=user >/dev/null
        npm install -g --silent "$PKG" || INSTALL_RC=$?
        ;;
esac

if [ "$INSTALL_RC" -ne 0 ]; then
    _otel_emit --category package --action install --subject "$ECO:$PKG" \
               --outcome error --attr eco="$ECO" --attr exit_code="$INSTALL_RC" 2>/dev/null || true
    _event_log --category package --action install --subject "$ECO:$PKG" \
               --outcome error --payload-key eco="$ECO" --payload-key exit_code="$INSTALL_RC" 2>/dev/null || true
    _record_lesson --category package --subject "$ECO:$PKG" \
                   --error-class "install_failed" \
                   --lesson "Package $ECO:$PKG failed to install (exit $INSTALL_RC). Verify the name and registry: 'uv pip search <name>' or pypi.org for python; 'apt-cache search <name>' for apt." 2>/dev/null || true
    exit "$INSTALL_RC"
fi

# ─── Step 2: update manifest in-place ───────────────────────────────────────
# No git operations. Working tree gets dirty on whatever branch is checked
# out. iris-curator picks up the dirty path on its next run and bundles all
# accumulated changes into one reviewable PR.

MANIFEST="$LEARN_DIR/$ECO.txt"
MANIFEST_CHANGED=0
if grep -qxF "$PKG" "$MANIFEST" 2>/dev/null; then
    echo "  (already in $ECO.txt — recording rationale only)"
else
    printf '%s\n' "$PKG" >> "$MANIFEST"
    MANIFEST_CHANGED=1
fi

# Always append rationale — even repeat asks are signal for the curator.
TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
{
    echo ""
    echo "## $TIMESTAMP — $ECO $PKG"
    echo "**Trigger:** $REASON"
} >> "$LEARN_DIR/rationale.md"

# ─── Step 3: success events ─────────────────────────────────────────────────

_otel_emit --category package --action install --subject "$ECO:$PKG" \
           --outcome ok --attr eco="$ECO" --attr manifest_changed="$MANIFEST_CHANGED" 2>/dev/null || true
_event_log --category package --action install --subject "$ECO:$PKG" --outcome ok \
           --payload-key eco="$ECO" --payload-key manifest_changed="$MANIFEST_CHANGED" 2>/dev/null || true

echo ""
echo "✓ learned $ECO $PKG"
[ "$MANIFEST_CHANGED" -eq 1 ] && echo "  manifest: iris/iris-learned/$ECO.txt (working tree dirty; curator will batch)"
echo "  next:    iris-curator --since 24h  (preview)  or  iris-curator --emit-pr  (commit + PR)"
